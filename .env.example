# Supabase Public Configuration (wajib di Vercel: Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Server Role Key (wajib untuk fitur Rolegod & Admin)
# Dapatkan di: Supabase Dashboard > Project Settings > API > Project API keys > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
